:include "inc/font-support.8o"

:macro vjump target ref {
    :calc dest { ( target - ref ) + 0x702  }
    jump dest
}
:macro vindex target ref {
    :calc dest { ( target - ref ) + 0x702  }
    i := dest
}


#--------------------------------------------------------------
# Load address, we assume 0x200 at the start as that's most
# of them, but jump first to dispatch non-0x200 based variants
:org 0x200
: main
    jump 0x702

#--------------------------------------------------------------
# CHIP-8 for ETI-660 with hires support
    jump 0x702

#--------------------------------------------------------------
# continuation of regular 0x200 based CHIP-8 variants
: continue
    setFont font-3x6

    drawText version 50 26
    drawText detection_str 1 2
    jump autodetect

:include "inc/autodetect.8o"

: chip8_detected
    prepareText variant_chip8
    jump print_detected_variant
: chip48_sc10_detected
    prepareText variant_chip48_sc10
    jump print_detected_variant
: schip_legacy_detected
    prepareText variant_schip_legacy
    jump print_detected_variant
: schip_modern_detected
    prepareText variant_schip_modern
    jump print_detected_variant
: original_megachip_detected
    prepareText variant_original_megachip
    jump print_detected_variant
: megachip_detected
    prepareText variant_megachip
    jump print_detected_variant
: xochip_detected
    prepareText variant_xo_chip8

: print_detected_variant
    v2 := 1
    v3 := 10
    drawTextRaw
    loop again

:org 0x302
    # If we are here, it's a CHIP-8 for ETI-660 without hires support
    # (load to 0x600)
    loop again

: version
    str-3x6 "v1.2" str-end

: detection_str
    str-3x6 "Detected" str-end

: variant_chip8
    str-3x6 "CHIP-8" str-end

: variant_chip48_sc10
    str-3x6 "CHIP-48/SC10" str-end

: variant_schip_legacy
    str-3x6 "SCHIP-LEGACY" str-end

: variant_schip_modern
    str-3x6 "SCHIP-MODERN" str-end

: variant_xo_chip8
    str-3x6 "XO-CHIP" str-end

: variant_original_megachip
    str-3x6 "RS-M8001 MC8" str-end

: variant_megachip
    str-3x6 "MC8 MODERN" str-end

:include "inc/font-3x6.8o"

: c8x-sprites
    0b11101010
    0b10001010
    0b10001110
    0b10001010
    0b11101010

    0b10111000
    0b10101000
    0b10111011
    0b10100000
    0b10100000

    0b00111010
    0b00101010
    0b10111001
    0b00101010
    0b00111010
: sprite-pixel
    0b10000000
    0b10000000
    0b00000000
    0b10000000
    0b10000000

#--------------------------------------------------------------
# CHIP-8X, CHIP-8X TPD, CHIP-8X FPD
:org 0x602
: c8x
    v0 := 0
    v1 := 0
    v5 := 0
    vindex sprite-pixel c8x
    sprite v0 v1 1
    v1 += 32
    sprite v0 v1 1
    v5 += vf
    if v5 != 0 then
        sprite v0 v1 1
    v1 += 32
    sprite v0 v1 1
    v5 += vf
    v2 := 7 # text color white
    v3 := 5 # font height
    v0 := 50
    v1 := 26
    v4 := 2
    i := 0x818
: c8x-l0
    0xb0 0x25
    sprite v0 v1 5
    i += v3
    v0 += 8
    v4 -= 1
    if v4 != 0 then
        vjump c8x-l0 c8x

    v0 := 1
    v1 := 2
    v4 := 4
    i := 0x804
: c8x-l1
    0xb0 0x25
    sprite v0 v1 5
    i += v3
    v0 += 8
    v4 -= 1
    if v4 != 0 then
        vjump c8x-l1 c8x

    v0 := 1
    v1 := 10
    v4 := 4
    vindex c8x-sprites c8x
: c8x-l2
    0xb0 0x25
    sprite v0 v1 5
    i += v3
    v0 += 8
    v4 -= 1
    if v4 != 0 then
        vjump c8x-l2 c8x

    0xb0 0x25
    v0 -= 4
    0xb0 0x25
    if v5 == 0 then
        i := 0x827
    if v5 == 1 then
        i := 0x822
    if v5 != 2 then
        sprite v0 v1 5

: c8x-end
    vjump c8x-end c8x


#--------------------------------------------------------------
# CHIP-8 TPD
:org 0x6A2
    jump 0x702

#--------------------------------------------------------------
# CHIP-8 FPD
:org 0x6BE
    jump 0x702

#--------------------------------------------------------------
# Most CHIP-8 variants, starting at 0x200
:org 0x702
    jump continue

: detected-sprite
    0b11000000
    0b10100100
    0b10101010
    0b10101100
    0b11000110

: sprite-pixel2
    0b01000000
    0b11100100
    0b01001010
    0b01001100
    0b00100110

    0b00000100
    0b11101110
    0b10000100
    0b10000100
    0b11100010

    0b00000010
    0b01000110
    0b10101010
    0b11001010
    0b01100110

    0b00000100
    0b10101100
    0b10100100
    0b10100100
    0b01001110

    0b00111000
    0b00001000
    0b00111000
    0b00100000
    0b10111000

    0b11101110
    0b00101010
    0b11101110
    0b10001000
    0b11101000

    0b10101110
    0b10101010
    0b11101110
    0b00101000
    0b00101000


: detect-quirks
    vf := 1
    v0 |= v0
    vc := vf
    :call font-lib-has-mem-quirk
    vc <<= vc
    vc <<= vc
    vc += vf
    i := sprite-pixel
    v0 := 0
    sprite v0 v0 1
    i := sprite-pixel2
    v1 := 63
    return