:include "inc/font-support.8o"

:macro vjump target ref {
    :calc dest { ( target - ref ) + 0x702  }
    jump dest
}
:macro vindex target ref {
    :calc dest { ( target - ref ) + 0x702  }
    i := dest
}


#--------------------------------------------------------------
# Load address, we assume 0x200 at the start as that's most
# of them, but jump first to dispatch non-0x200 based variants
:org 0x200
: main
    jump 0x702

#--------------------------------------------------------------
# CHIP-8 for ETI-660 with hires support
    jump 0x702

#--------------------------------------------------------------
# continuation of regular 0x200 based CHIP-8 variants
: continue
    setFont font-3x6

:include "inc/autodetect.8o"

: version
    str-3x6 "v1.3" str-end

: detection_str
    str-3x6 "Detected" str-end

:org 0x302
    # If we are here, it's a CHIP-8 for ETI-660 without hires support
    # (load to 0x600)
    loop again

: variant_chip8
    str-3x6 "CHIP-8" str-end

: variant_chip48
    str-3x6 "CHIP-48" str-end

: variant_schip10
    str-3x6 "SCHIP-1.0" str-end

: variant_schip_legacy
    str-3x6 "SCHIP-LEGACY" str-end

: variant_schip_modern
    str-3x6 "SCHIP-MODERN" str-end

: variant_xo_chip8
    str-3x6 "XO-CHIP" str-end

: variant_original_megachip
    str-3x6 "RS-M8001 MC8" str-end

: variant_megachip
    str-3x6 "MC8-MODERN" str-end

:include "inc/font-3x6.8o"

: c8x-sprites
    0b11101010
    0b10001010
    0b10001110
    0b10001010
    0b11101010

    0b10111000
    0b10101000
    0b10111011
    0b10100000
    0b10100000

    0b00111010
    0b00101010
    0b10111001
    0b00101010
    0b00111010
: sprite-pixel
    0b10000000
    0b10000000
    0b00000000
    0b10000000
    0b10000000

#--------------------------------------------------------------
# CHIP-8X, CHIP-8X TPD, CHIP-8X FPD
:org 0x602
: c8x
    v0 := 0
    v1 := 0
    v5 := 0
    vindex sprite-pixel c8x
    sprite v0 v1 1
    v1 += 32
    sprite v0 v1 1
    v5 += vf
    if v5 != 0 then
        sprite v0 v1 1
    v1 += 32
    sprite v0 v1 1
    v5 += vf
    v2 := 7 # text color white
    v3 := 5 # font height
    v0 := 50
    v1 := 26
    v4 := 2
    i := 0x818
: c8x-l0
    0xb0 0x25
    sprite v0 v1 5
    i += v3
    v0 += 8
    v4 -= 1
    if v4 != 0 then
        vjump c8x-l0 c8x

    v0 := 1
    v1 := 2
    v4 := 4
    i := 0x804
: c8x-l1
    0xb0 0x25
    sprite v0 v1 5
    i += v3
    v0 += 8
    v4 -= 1
    if v4 != 0 then
        vjump c8x-l1 c8x

    v0 := 1
    v1 := 10
    v4 := 4
    vindex c8x-sprites c8x
: c8x-l2
    0xb0 0x25
    sprite v0 v1 5
    i += v3
    v0 += 8
    v4 -= 1
    if v4 != 0 then
        vjump c8x-l2 c8x

    0xb0 0x25
    v0 -= 4
    0xb0 0x25
    if v5 == 0 then
        i := 0x827
    if v5 == 1 then
        i := 0x822
    if v5 != 2 then
        sprite v0 v1 5

: c8x-end
    vjump c8x-end c8x


#--------------------------------------------------------------
# CHIP-8 TPD
:org 0x6A2
    jump 0x702

#--------------------------------------------------------------
# CHIP-8 FPD
:org 0x6BE
    jump 0x702

#--------------------------------------------------------------
# Most CHIP-8 variants, starting at 0x200
:org 0x702
    jump continue

: detected-sprite
    0b11000000
    0b10100100
    0b10101010
    0b10101100
    0b11000110

: sprite-pixel2
    0b01000000
    0b11100100
    0b01001010
    0b01001100
    0b00100110

    0b00000100
    0b11101110
    0b10000100
    0b10000100
    0b11100010

    0b00000010
    0b01000110
    0b10101010
    0b11001010
    0b01100110

    0b00000100
    0b10101100
    0b10100100
    0b10100100
    0b01001110

    0b00111000
    0b00001000
    0b00111000
    0b00001000
    0b10111000

    0b11101110
    0b00101010
    0b11101110
    0b10001000
    0b11101000

    0b10101110
    0b10101010
    0b11101110
    0b00101000
    0b00101000

: vfr-sprites
    0b10101110
    0b10101000
    0b10101100
    0b10101000
    0b01001000

    0b11100000
    0b10100000
    0b11000000
    0b10100000
    0b10100000

: mem-sprites
    0b10101110
    0b11101000
    0b11101100
    0b10101000
    0b10101110

: memq
    0b10101110
    0b11100010
    0b11100100
    0b10100000
    0b10100100

: mem0
    0b10101110
    0b11101010
    0b11101010
    0b10101010
    0b10101110

: memx
    0b10101010
    0b11101010
    0b11100100
    0b10101010
    0b10101010

: mem1
    0b10100100
    0b11101100
    0b11100100
    0b10100100
    0b10101110

: shf-sprites
    0b11101010
    0b10001010
    0b11101110
    0b00101010
    0b11101010

    0b11100000
    0b10000000
    0b11000000
    0b10000000
    0b10000000

: jmp-sprites
    0b00101010
    0b00101110
    0b00101110
    0b10101010
    0b01001010

: letter-p
    0b11100000
    0b10100000
    0b11100000
    0b10000000
    0b10000000

: dwait-sprites
    0b11001010
    0b10101010
    0b10101110
    0b10101110
    0b11001010

    0b11100000
    0b01000000
    0b01000000
    0b01000000
    0b01000000

: wrp-sprites
    0b10101110
    0b10101010
    0b11101100
    0b11101010
    0b10101010

: plus
    0b00000000
    0b01000000
    0b11100000
    0b01000000
    0b00000000

: minus
    0b00000000
    0b00000000
    0b11100000
    0b00000000
    0b00000000

: checkmark
    0b00000000
    0b10100000
    0b11000000
    0b10000000
    0b00000000

: fail
    0b00000000
    0b10100000
    0b01000000
    0b10100000
    0b00000000

: question
    0b11100000
    0b00100000
    0b01000000
    0b00000000
    0b01000000

    #00

#--------------------------------------------------------------
: chip8_detected
    prepareText variant_chip8
    i := quirks-chip8
    jump print_detected_variant
: chip48_detected
    prepareText variant_chip48
    i := quirks-chip48
    jump print_detected_variant
: schip10_detected
    prepareText variant_schip10
    i := quirks-schip10
    jump print_detected_variant
: schip_legacy_detected
    prepareText variant_schip_legacy
    i := quirks-schip11
    jump print_detected_variant
: schip_modern_detected
    prepareText variant_schip_modern
    i := quirks-schip-modern
    jump print_detected_variant
: original_megachip_detected
    vd := 1
    prepareText variant_original_megachip
    i := quirks-org-mc8
    jump print_detected_variant
: megachip_detected
    prepareText variant_megachip
    i := quirks-mc8
    jump print_detected_variant
: xochip_detected
    prepareText variant_xo_chip8
    i := quirks-xochip

: print_detected_variant
    v7 := v0
    v8 := v1
    load v6
    i := quirks-expected
    save v6

    :call check-dwait-quirk
    i := dw-result
    save v0

    drawText version 50 2
    drawText detection_str 1 2
    vd := 0
    vc := 0

    v0 := v7
    v1 := v8
    v2 := 1
    v3 := 10
    drawTextRaw
    :call detect-quirks
    loop again

#--------------------------------------------------------------
:macro checkAndShow quirknum {
    v0 := quirknum
    :call check-result
}

: quirks-chip8 # VFR MEM SHF JMP DWT WRP VIDEO-MODES (LORES=1, HIRES=2, MEGA=4)
    0 2 5 1 1 3 1
    0 2 5 1 1 3 1
: quirks-chip48
    3 1 0 0 1 3 1
: quirks-schip10
    3 1 0 0 1 3 3
: quirks-schip11
    3 0 0 0 1 3 3
: quirks-schip-modern
    3 0 0 0 0 3 3
: quirks-org-mc8
    3 0 0 2 0 3 7
: quirks-mc8
    3 0 0 1 0 0x43 7
: quirks-xochip
    3 2 5 0 0 0 0xB
: quirks-expected
    0 0 0 0 0 0
: video-modes
    0 0
: dw-result
    0 0
: detect-quirks
    # - - - - - - - - - - - - - - - - - -
    # logic
    vf := 1
    v0 |= v0
    vc := vf
    vf := 1
    v0 &= v0
    vc += vf
    vf := 1
    v0 ^= v0
    vc += vf
    v6 := 1
    v7 := 18
    v2 := 5
    i := vfr-sprites
    sprite v6 v7 5
    v6 += 8
    i += v2
    sprite v6 v7 5
    v6 += 4
    i := question
    if vc == 0 then
        i := minus
    if vc == 3 then
        i := plus
    sprite v6 v7 5
    checkAndShow 0

    # - - - - - - - - - - - - - - - - - -
    # memory
    :call font-lib-has-mem-quirk
    vc := vf
    v6 := 1
    v7 := 24
    i := mem-sprites
    sprite v6 v7 5
    v6 += 8
    i += v2
    i := memq
    if vc == 0 then
        i := mem0
    i := mem0
    if vc == 1 then
        i := memx
    if vc == 2 then
        i := mem1
    sprite v6 v7 5
    v6 += 4
    checkAndShow 1

    # - - - - - - - - - - - - - - - - - -
    # shifting
    v6 := 23
    v7 := 18
    i := shf-sprites
    sprite v6 v7 5
    v6 += 8
    i += v2
    sprite v6 v7 5

    v1 := 2
    v0 := 0
    v0 >>= v1
    vc := 0
    vc += v0
    v0 <<= v1
    vc += v0

    v6 += 4
    i := question
    if vc == 0 then
        i := plus
    if vc == 5 then
        i := minus
    sprite v6 v7 5
    checkAndShow 2

    # - - - - - - - - - - - - - - - - - -
    # Bxnn
    v6 := 23
    v7 := 24
    i := jmp-sprites
    sprite v6 v7 5
    v6 += 8
    i += v2
    sprite v6 v7 5

    vc := 0
    if vd == 1 begin
        vc := 2
        jump quirk-bnnn-result
    end
    v0 := 0
    v8 := 2
    jump0 quirk-has-bnnn
: quirk-has-bnnn
    vc := 1
: quirk-bnnn-result
    v6 += 4
    i := question
    if vc == 0 then
        i := plus
    if vc == 1 then
        i := minus
    sprite v6 v7 5
    checkAndShow 3

    # - - - - - - - - - - - - - - - - - -
    # display wait
    # possible values:
    # 0 none
    # 1 lores
    # 2 hires
    # 3 hires+lores
    v6 := 44
    v7 := 18
    i := dwait-sprites
    sprite v6 v7 5
    v6 += 8
    i += v2
    sprite v6 v7 5
    i := dw-result
    load v0
    vc := v0
    i := question
    if vc == 0 then
        i := minus
    if vc == 1 then
        i := plus
    v6 += 4
    sprite v6 v7 5
    checkAndShow 4

    # - - - - - - - - - - - - - - - - - -
    # wrapping
    # possible values:
    # 0 clip
    # 1 wrap initial coordinates lores
    # 2 wrap initial coordinates hires
    # 4 wrap lores-x
    # 8 wrap lores-y
    # 16 wrap hires-x
    # 32 wrap hires-y
    # 64 wrap mega-8 x
    # 128 wrap mega-8 y
    v6 := 44
    v7 := 24
    i := wrp-sprites
    sprite v6 v7 5
    v6 += 8
    i := letter-p
    sprite v6 v7 5
    v6 += 4
    i := minus
    sprite v6 v7 5
    checkAndShow 5
    return

: check-dwait-quirk
    v0 := 1
    :call dwait-test
    vc := v0
    i := video-modes
    load v0
    vf := 2
    v0 &= vf
    if v0 == 2 begin
        hires
        v0 := 2
        :call dwait-test
        vc |= v0
        lores
    end
    v0 := vc
    return

: dwait-test
    v4 := v0
    v0 := 0
    v1 := 0
    v2 := 5
    i := sprite-pixel
    sprite v0 v0 1
    delay := v2
    loop
        sprite v0 v0 1
        v1 += 1
        if v1 == 0 then
            v1 := 0x80
        v3 := delay
        if v3 != 0 then
    again
    v3 := v1
    v2 := 1
    v3 &= v2
    if v3 == 0 then
        sprite v0 v0 1
    if v1 >= 4 begin
        if v1 <= 6 begin
            v0 := v4
        end
    else
        v0 := 0xff
    end
    return

: check-result
    i := quirks-expected
    i += v0
    load v0
    i := fail
    v6 += 4
    if v0 == vc then
        i := checkmark
    sprite v6 v7 5
    return