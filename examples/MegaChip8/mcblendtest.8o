#--------------------------------------------------------------
# MegaChip support macros
:macro megaoff { :byte 0x00  :byte 0x10 }
:macro megaon { :byte 0x00 :byte 0x11 }
:macro scroll_up n {
    :calc BN { 0xB0 + ( n & 0xF ) }
    :byte 0x00 :byte BN
}
:macro ldhi nnnn {
    :byte 0x01 :byte 0x00 :pointer nnnn
}
:macro ldpal nn { :byte 0x02 :byte nn }
:macro sprw nn { :byte 0x03 :byte nn }
:macro sprh nn { :byte 0x04 :byte nn }
:macro alpha nn { :byte 0x05 :byte nn }
:macro digisnd n { :calc ZN { n & 0xF } :byte 0x06 :byte ZN }
:macro stopsnd { :byte 0x07 :byte 0x00 }
:macro bmode n { :calc ZN { n & 0xF } :byte 0x08 :byte ZN }
:macro ccol nn { :byte 0x09 :byte nn }
#--------------------------------------------------------------

: main
    megaon
    i := mc_palette
    ldpal 90
    :call draw_background
    ldhi mc8-0-0
    sprw 81
    sprh 74
    bmode 0
    v0 := 86
    v1 := 60
    sprite v0 v1 0
    v0 := 53
    v1 := 30
    ldhi pac-0-0
    sprw 44
    sprh 48
    bmode 0
    sprite v0 v1 1
    v0 += 50
    bmode 1
    sprite v0 v1 1
    v0 += 50
    bmode 2
    sprite v0 v1 1
    v0 := 53
    v1 := 100
    bmode 3
    sprite v0 v1 1
    v0 += 50
    bmode 4
    sprite v0 v1 1
    v0 += 50
    bmode 5
    sprite v0 v1 1
    clear
: wait
    jump wait

: draw_background
    ldhi tile-0-0
    v0 := 20
    v1 := 15
    sprw 54
    sprh 54
    bmode 0
    sprite v0 v1 0
    v0 += 54
    sprite v0 v1 0
    v0 += 54
    sprite v0 v1 0
    v0 += 54
    sprite v0 v1 0
    v0 := 20
    v1 += 54
    sprite v0 v1 0
    v0 += 54
    sprite v0 v1 0
    v0 += 54
    sprite v0 v1 0
    v0 += 54
    sprite v0 v1 0
    v0 := 20
    v1 += 54
    sprite v0 v1 0
    v0 += 54
    sprite v0 v1 0
    v0 += 54
    sprite v0 v1 0
    v0 += 54
    sprite v0 v1 0
    return

